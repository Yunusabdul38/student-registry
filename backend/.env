# Application environment (development or production)
APP_ENVIRONMENT="development"

# Port for the API server to listen on
PORT="9090"

# Database connection string (PostgreSQL format)
DATABASE_URL="postgres://postgres:password@localhost:5432/student-registry"

# Database name (used for specific operations)
DATABASE_NAME="student-registry"

# Maximum number of connections in the database pool
DATABASE_POOL_MAX_SIZE="10"

# Database name (used for specific operations)
DATABASE_DB="student-registry"

# Database password
POSTGRES_PASSWORD="fanofafan"

